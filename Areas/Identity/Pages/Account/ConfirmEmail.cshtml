@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Correo confirmado";
    Layout = "/Views/Shared/_LayoutAuth.cshtml";
}

@if (Model.Confirmed)
{
    <div class="account-message w-100" >
        <div class="app-card auth-status-card">
            <div class="app-card-body p-5">
                <i class="icon-extra-large bi bi-check-circle-fill text-success" ></i>
                <h2 class="fw-bold mt-3 mb-2">Correo confirmado</h2>
                <p class="text-muted">Su correo ha sido confirmado exitosamente. Ya puede iniciar sesión.</p>
                <a href="/Identity/Account/Login" class="btn btn-primary mt-3">Iniciar sesión</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="account-message w-100" >
        <div class="app-card auth-status-card">
            <div class="app-card-body p-5">
                <i class="icon-extra-large bi bi-x-circle-fill text-danger" ></i>
                <h2 class="fw-bold mt-3 mb-2">Error de confirmación</h2>
                <p class="text-muted">No se pudo confirmar el correo. El enlace puede ser inválido o haber expirado.</p>
                <a asp-page="./ResendEmailConfirmation" class="btn btn-primary mt-3">Reenviar correo de confirmación</a>
            </div>
        </div>
    </div>
}
