@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Correo enviado";
    Layout = "/Views/Shared/_LayoutAuth.cshtml";
}

<div class="account-message w-100" >
    <div class="app-card">
        <div class="app-card-body p-5">
            <i class="icon-extra-large bi bi-envelope-check text-success" ></i>
            <h2 class="fw-bold mt-3 mb-2">Correo enviado</h2>
            <p class="text-muted">Revise su bandeja de entrada para restablecer su contraseña. Si no encuentra el correo, revise la carpeta de spam.</p>
            <a asp-page="./Login" class="btn btn-primary mt-3">Volver a inicio de sesión</a>
        </div>
    </div>
</div>
