@page
@model LogoutModel
@{
    ViewData["Title"] = "Cerrar sesión";
    Layout = "/Views/Shared/_LayoutAuth.cshtml";
}

<div class="account-message w-100" >
    <div class="app-card">
        <div class="app-card-body p-5">
            @{
                if (User.Identity?.IsAuthenticated ?? false)
                {
                    <i class="icon-extra-large bi bi-box-arrow-right text-primary" ></i>
                    <h2 class="fw-bold mt-3 mb-2">Cerrar sesión</h2>
                    <p class="text-muted mb-4">¿Está seguro que desea cerrar sesión?</p>
                    <form class="d-grid" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                        <button type="submit" class="btn btn-primary btn-lg">Cerrar sesión</button>
                    </form>
                }
                else
                {
                    <i class="icon-extra-large bi bi-check-circle-fill text-success" ></i>
                    <h2 class="fw-bold mt-3 mb-2">Sesión cerrada</h2>
                    <p class="text-muted">Ha cerrado sesión exitosamente.</p>
                    <a asp-page="./Login" class="btn btn-primary mt-3">Volver a inicio de sesión</a>
                }
            }
        </div>
    </div>
</div>
