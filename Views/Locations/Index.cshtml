@model List<BioGamaEcuador.Models.Location>

@{
    ViewData["Title"] = "Ubicaciones";
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">Ubicaciones</h1>
        <p class="page-header-subtitle">Puntos de muestreo y localidades geográficas</p>
    </div>
    <div class="page-header-actions">
        @if (User.IsInRole("Administrador") || User.IsInRole("Investigador"))
        {
            <a class="btn btn-primary" asp-action="Create">
                <i class="bi bi-plus-lg me-1"></i>Nueva ubicación
            </a>
        }
    </div>
</div>

<div class="filter-card">
    <div class="app-card">
        <div class="app-card-body">
            <form method="get" asp-action="Index">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-5">
                        <label class="visually-hidden" for="filter-busqueda">Buscar</label>
                        <input id="filter-busqueda" type="text" name="busqueda" class="form-control" placeholder="Buscar por lugar…"
                               value="@ViewBag.Busqueda" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="visually-hidden" for="filter-reserva">Reserva natural</label>
                        <select id="filter-reserva" name="reserva" class="form-select">
                            <option value="">Todas las reservas</option>
                            @foreach (var r in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>?)ViewBag.Reservas
                            ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                            {
                                <option value="@r.Value" selected="@(ViewBag.ReservaFiltro == r.Value)">@r.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-3 d-flex gap-2">
                        <button class="btn btn-outline-secondary w-100"><i class="bi bi-funnel me-1"></i>Filtrar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary w-100"><i class="bi bi-x-circle me-1"></i>Limpiar</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="app-card table-card">
    <div class="app-card-header">
        <h5><i class="bi bi-geo-alt me-2"></i>Listado de ubicaciones</h5>
        <span class="badge badge-soft-primary">Total: @ViewBag.TotalItems</span>
    </div>
    <div class="app-card-body p-0">
        <div class="table-responsive">
            <table class="app-table">
                <thead>
                    <tr>
                        <th>Lugar</th>
                        <th>Altitud</th>
                        <th>Latitud</th>
                        <th>Longitud</th>
                        <th>Reserva natural</th>
                        <th class="actions-cell">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-medium">@item.PlaceName</td>
                            <td>@(item.Altitude > 0 ? $"{item.Altitude} m" : "—")</td>
                            <td>@(item.Latitude != 0 ? $"{item.Latitude}°" : "—")</td>
                            <td>@(item.Longitude != 0 ? $"{item.Longitude}°" : "—")</td>
                            <td>@(item.NaturalReserve?.Name ?? "—")</td>
                            <td class="actions-cell">
                                <partial name="_RowActions" model='@(new BioGamaEcuador.Models.RowActionsModel(item.Id, AdminOnlyEdit: false, Tooltips: false, ViewFirst: false))' />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <h5>No hay ubicaciones registradas</h5>
                    <p>Comience creando una nueva ubicación.</p>
                </div>
            }
        </div>
    </div>
</div>

<partial name="_Pagination" model="BioGamaEcuador.Models.PaginationModel.From(ViewContext)" />
