@model BioGamaEcuador.Models.Record

@{
    ViewData["Title"] = "Nuevo Registro";
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">Nuevo Registro</h1>
        <p class="page-header-subtitle">Ingrese los datos del avistamiento</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>
</div>

<div class="app-card form-card">
    <div class="app-card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-section">
                <h6 class="form-section-title"><i class="bi bi-info-circle me-2"></i>Información del avistamiento</h6>
                <div class="row g-3">
                    <partial name="_FormFields" model="Model" />
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" checked="@Model.IsActive" />
                            <label class="form-check-label" asp-for="IsActive">Registro activo</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
