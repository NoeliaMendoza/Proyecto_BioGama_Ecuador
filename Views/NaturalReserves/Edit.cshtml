@model BioGamaEcuador.Models.NaturalReserve

@{
    ViewData["Title"] = "Editar Reserva Natural";
}

<div class="app-card form-card">
    <div class="app-card-header">
        <h5><i class="bi bi-pencil-square me-2"></i>Editar reserva natural</h5>
    </div>
    <div class="app-card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />

            <partial name="_FormFields" model="Model" />

            <div class="form-check mb-4">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Activa</label>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar cambios</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i>Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
