@model List<BioGamaEcuador.Models.NaturalReserve>

@{
    ViewData["Title"] = "Reservas naturales";
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">Reservas naturales</h1>
        <p class="page-header-subtitle">Áreas protegidas y reservas registradas</p>
    </div>
    <div class="page-header-actions">
        @if (User.IsInRole("Administrador") || User.IsInRole("Investigador"))
        {
            <a class="btn btn-primary" asp-action="Create">
                <i class="bi bi-plus-lg me-1"></i>Nueva reserva
            </a>
        }
    </div>
</div>

<div class="filter-card">
    <div class="app-card">
        <div class="app-card-body">
            <form method="get" asp-action="Index">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-5">
                        <label class="visually-hidden" for="filter-busqueda">Buscar</label>
                        <input id="filter-busqueda" type="text" name="busqueda" class="form-control" placeholder="Buscar por nombre…"
                               value="@ViewBag.Busqueda" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="visually-hidden" for="filter-region">Región</label>
                        <select id="filter-region" name="region" class="form-select">
                            <option value="">Todas las regiones</option>
                            @foreach (var r in (List<string>?)ViewBag.Regiones ?? new List<string>())
                            {
                                <option value="@r" selected="@(ViewBag.RegionFiltro == r)">@r</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-3 d-flex gap-2">
                        <button class="btn btn-outline-secondary w-100"><i class="bi bi-funnel me-1"></i>Filtrar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary w-100"><i class="bi bi-x-circle me-1"></i>Limpiar</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="app-card table-card">
    <div class="app-card-header">
        <h5><i class="bi bi-tree me-2"></i>Listado de reservas</h5>
        <span class="badge badge-soft-primary">Total: @ViewBag.TotalItems</span>
    </div>
    <div class="app-card-body p-0">
        <div class="table-responsive">
            <table class="app-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Región</th>
                        <th>Superficie (ha)</th>
                        <th>Año creación</th>
                        <th>Estado</th>
                        <th class="actions-cell">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Region</td>
                            <td>@item.SurfaceHectares.ToString("N2")</td>
                            <td>@item.YearCreated</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge badge-soft-success">Activa</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-danger">Inactiva</span>
                                }
                            </td>
                            <td class="actions-cell">
                                <partial name="_RowActions" model='@(new BioGamaEcuador.Models.RowActionsModel(item.Id, AdminOnlyEdit: false, Tooltips: false, ViewFirst: false))' />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <h5>No hay reservas registradas</h5>
                    <p>Comience creando una nueva reserva natural.</p>
                </div>
            }
        </div>
    </div>
</div>

<partial name="_Pagination" model="BioGamaEcuador.Models.PaginationModel.From(ViewContext)" />
