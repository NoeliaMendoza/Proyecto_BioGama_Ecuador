@model BioGamaEcuador.Models.NaturalReserve

            <div class="form-floating mb-3">
                <input asp-for="Name" class="form-control" placeholder="Nombre de la reserva" />
                <label asp-for="Name"><i class="bi bi-tree me-1"></i>Nombre de la reserva</label>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <select asp-for="Region" class="form-select">
                    <option value="">-- Seleccione una región --</option>
                    <option value="Costa">Costa</option>
                    <option value="Sierra">Sierra</option>
                    <option value="Amazonía">Amazonía</option>
                    <option value="Galápagos">Galápagos</option>
                </select>
                <label asp-for="Region"><i class="bi bi-geo-alt me-1"></i>Región natural</label>
                <span asp-validation-for="Region" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="SurfaceHectares" class="form-control" placeholder="Superficie (ha)" type="number" step="0.01" />
                <label asp-for="SurfaceHectares"><i class="bi bi-arrows-angle-expand me-1"></i>Superficie (ha)</label>
                <span asp-validation-for="SurfaceHectares" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="YearCreated" class="form-control" placeholder="Año de creación" type="number" min="1900" max="2100" />
                <label asp-for="YearCreated"><i class="bi bi-calendar me-1"></i>Año de creación</label>
                <span asp-validation-for="YearCreated" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <textarea asp-for="Description" class="textarea-description form-control" placeholder="Descripción" ></textarea>
                <label asp-for="Description"><i class="bi bi-card-text me-1"></i>Descripción</label>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
