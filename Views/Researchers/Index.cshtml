@model List<BioGamaEcuador.Models.Researcher>

@{
    ViewData["Title"] = "Investigadores";
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">Investigadores</h1>
        <p class="page-header-subtitle">Científicos y colaboradores del proyecto</p>
    </div>
    <div class="page-header-actions">
        @if (User.IsInRole("Administrador"))
        {
            <a class="btn btn-primary" asp-action="Create">
                <i class="bi bi-plus-lg me-1"></i>Nuevo investigador
            </a>
        }
    </div>
</div>

<div class="filter-card">
    <div class="app-card">
        <div class="app-card-body">
            <form method="get" asp-action="Index">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-5">
                        <label class="visually-hidden" for="filter-nombre">Nombre</label>
                        <input id="filter-nombre" type="text" name="nombre" class="form-control" placeholder="Buscar por nombre…"
                               value="@ViewBag.Nombre" />
                    </div>
                    <div class="col-12 col-md-5">
                        <label class="visually-hidden" for="filter-institucion">Institución</label>
                        <input id="filter-institucion" type="text" name="institucion" class="form-control" placeholder="Buscar por institución…"
                               value="@ViewBag.Institucion" />
                    </div>
                    <div class="col-12 col-md-2 d-flex gap-2">
                        <button class="btn btn-outline-secondary w-100"><i class="bi bi-funnel me-1"></i>Filtrar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary w-100"><i class="bi bi-x-circle me-1"></i>Limpiar</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="app-card table-card">
    <div class="app-card-header">
        <h5><i class="bi bi-people me-2"></i>Listado de investigadores</h5>
        <span class="badge badge-soft-primary">Total: @ViewBag.TotalItems</span>
    </div>
    <div class="app-card-body p-0">
        <div class="table-responsive">
            <table class="app-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Institución</th>
                        <th>Correo</th>
                        <th>Especialidad</th>
                        <th class="actions-cell">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-medium">@item.Name</td>
                            <td>@item.Institution</td>
                            <td>@item.Email</td>
                            <td>@item.Specialty</td>
                            <td class="actions-cell">
                                <partial name="_RowActions" model='@(new BioGamaEcuador.Models.RowActionsModel(item.Id, AdminOnlyEdit: true, Tooltips: false, ViewFirst: false))' />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <h5>No hay investigadores registrados</h5>
                    <p>Comience creando un nuevo investigador.</p>
                </div>
            }
        </div>
    </div>
</div>

<partial name="_Pagination" model="BioGamaEcuador.Models.PaginationModel.From(ViewContext)" />
