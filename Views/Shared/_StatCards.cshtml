@model IReadOnlyList<BioGamaEcuador.Models.StatCardModel>
@foreach (var card in Model)
{
    <div class="@card.ColumnClass">
        <div class="stat-card">
            <div class="stat-card-icon @card.Color"><i class="bi @card.Icon"></i></div>
            <div class="stat-card-label">@card.Label</div>
            <div class="stat-card-value">@card.Value.ToString("N0")</div>
        </div>
    </div>
}
