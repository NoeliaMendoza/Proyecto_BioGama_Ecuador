        <div class="landing-hero-overlay"></div>
        <div class="landing-hero-content">
            <span class="landing-hero-badge">Biodiversidad del Ecuador</span>
            <h1 class="landing-hero-title">BioGama Ecuador</h1>
            <p class="landing-hero-subtitle">Centraliza el conocimiento sobre la biodiversidad ecuatoriana. Flora, fauna y hongos documentados por investigadores de todo el país.</p>
            <div class="landing-hero-actions">
                <a asp-controller="Public" asp-action="Catalogo" class="btn btn-light btn-lg px-4">
                    <i class="bi bi-book me-2"></i>Explorar especies
                </a>
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-light btn-lg px-4">
                    <i class="bi bi-person-plus me-2"></i>Registrarse
                </a>
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-light btn-lg px-4">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar sesión
                </a>
            </div>
        </div>
    </div>

    <div class="landing-stats-bar">
        <div class="landing-stat-item">
            <div class="landing-stat-number" id="statEspecies">0</div>
            <div class="landing-stat-label">Especies registradas</div>
        </div>
        <div class="landing-stat-divider"></div>
        <div class="landing-stat-item">
            <div class="landing-stat-number" id="statFamilias">0</div>
            <div class="landing-stat-label">Familias biológicas</div>
        </div>
        <div class="landing-stat-divider"></div>
        <div class="landing-stat-item">
            <div class="landing-stat-number" id="statReservas">0</div>
            <div class="landing-stat-label">Reservas naturales</div>
        </div>
        <div class="landing-stat-divider"></div>
        <div class="landing-stat-item">
            <div class="landing-stat-number" id="statRegistros">0</div>
            <div class="landing-stat-label">Avistamientos</div>
        </div>
    </div>

    <div class="landing-section">
        <div class="landing-section-header">
            <h2>¿Qué puedes hacer?</h2>
            <p>Explora, colabora y contribuye al conocimiento de la biodiversidad ecuatoriana.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="landing-feature-card">
                    <div class="icon-accent-primary landing-feature-icon" >
                        <i class="bi bi-search-heart"></i>
                    </div>
                    <h5>Explorar catálogo</h5>
                    <p>Navega por miles de especies de flora, fauna y hongos documentadas con información científica detallada.</p>
                    <a asp-controller="Public" asp-action="Catalogo" class="landing-feature-link">
                        Ver especies <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="landing-feature-card">
                    <div class="icon-sky landing-feature-icon" >
                        <i class="bi bi-journal-text"></i>
                    </div>
                    <h5>Documentar hallazgos</h5>
                    <p>Los investigadores pueden registrar avistamientos, ubicaciones y observaciones de campo en tiempo real.</p>
                    <a asp-area="Identity" asp-page="/Account/Register" class="landing-feature-link">
                        Unirse como investigador <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="landing-feature-card">
                    <div class="icon-amber landing-feature-icon" >
                        <i class="bi bi-bar-chart-line"></i>
                    </div>
                    <h5>Reportes y estadísticas</h5>
                    <p>Accede a datos consolidados sobre distribución de especies, estados de conservación y más.</p>
                    <a asp-area="Identity" asp-page="/Account/Login" class="landing-feature-link">
                        Iniciar sesión <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="landing-section landing-section-alt">
        <div class="landing-section-header">
            <h2>Tres roles, un objetivo</h2>
            <p>Cada usuario tiene un propósito en la conservación de la biodiversidad.</p>
        </div>
        <div class="row g-4 justify-content-center">
            <div class="col-md-4">
                <div class="landing-role-card">
                    <div class="background-accent landing-role-icon" >
                        <i class="color-primary bi bi-shield-check" ></i>
                    </div>
                    <h5>Administrador</h5>
                    <p>Gestiona el catálogo completo, familias, reservas, ubicaciones y usuarios del sistema.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="landing-role-card">
                    <div class="background-sky landing-role-icon" >
                        <i class="color-sky bi bi-binoculars" ></i>
                    </div>
                    <h5>Investigador</h5>
                    <p>Registra hallazgos de campo, documenta especies y contribuye con observaciones científicas.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="landing-role-card">
                    <div class="background-pale-green landing-role-icon" >
                        <i class="color-primary-light bi bi-globe-americas" ></i>
                    </div>
                    <h5>Público</h5>
                    <p>Consulta la biodiversidad registrada, explora el catálogo y aprende sobre las especies del Ecuador.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="landing-section text-center pb-5">
        <div class="landing-cta">
            <h3>¿Listo para explorar la biodiversidad del Ecuador?</h3>
            <p>Únete a nuestra comunidad y contribuye al conocimiento científico.</p>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-lg px-5">
                <i class="bi bi-person-plus me-2"></i>Crear cuenta gratuita
            </a>
        </div>
    </div>

    <script>
        (function() {
            var stats = [
                { el: document.getElementById('statEspecies'), target: @totalEspecies },
                { el: document.getElementById('statFamilias'), target: @totalFamilias },
                { el: document.getElementById('statReservas'), target: @totalReservas },
                { el: document.getElementById('statRegistros'), target: @totalRegistros }
            ];
            function animateStats() {
                stats.forEach(function(s) {
                    if (!s.el || s.target === 0) return;
                    var duration = 1500, start = null;
                    function step(timestamp) {
                        if (!start) start = timestamp;
                        var progress = Math.min((timestamp - start) / duration, 1);
                        var eased = 1 - Math.pow(1 - progress, 3);
                        s.el.textContent = Math.floor(eased * s.target).toLocaleString('es');
                        if (progress < 1) requestAnimationFrame(step);
                        else s.el.textContent = s.target.toLocaleString('es');
                    }
                    requestAnimationFrame(step);
                });
            }
            if ('IntersectionObserver' in window) {
                var obs = new IntersectionObserver(function(entries) {
                    entries.forEach(function(e) { if (e.isIntersecting) { animateStats(); obs.disconnect(); } });
                });
                document.querySelectorAll('.landing-stats-bar')[0] && obs.observe(document.querySelector('.landing-stats-bar'));
            } else { animateStats(); }
        })();
    </script>
}
else if (isPublicUser)
{
    <div class="hero-amazon-background public-dash-hero" >
        <div class="public-dash-overlay"></div>
        <div class="public-dash-content">
            <span class="public-dash-badge">Bienvenido</span>
            <h1 class="public-dash-title">Explora la biodiversidad</h1>
            <p class="public-dash-desc">Accede al catálogo completo de especies, consulta registros de avistamiento y conoce más sobre la riqueza natural del Ecuador.</p>
        </div>
    </div>

    <div class="row g-3 mt-4">
        <partial name="_StatCards" model='@(new BioGamaEcuador.Models.StatCardModel[] { new("Especies", totalEspecies, "bi-bug", "primary", "col-6 col-lg-3"), new("Flora", totalFlora, "bi-flower2", "secondary", "col-6 col-lg-3"), new("Fauna", totalFauna, "bi-binoculars", "info", "col-6 col-lg-3"), new("Hongos", totalHongos, "bi-moisture", "warning", "col-6 col-lg-3") })' />
    </div>

    <div class="row g-3 mt-2 mb-4">
        <partial name="_StatCards" model='@(new BioGamaEcuador.Models.StatCardModel[] { new("Familias", totalFamilias, "bi-tree", "primary", "col-sm-6 col-lg"), new("Registros", totalRegistros, "bi-journal-text", "info", "col-sm-6 col-lg"), new("Ubicaciones", totalUbicaciones, "bi-geo-alt", "secondary", "col-sm-6 col-lg"), new("Investigadores", totalInvestigadores, "bi-person-badge", "warning", "col-sm-6 col-lg") })' />
    </div>



    <partial name="_DashboardCharts" />

    <partial name="_RecentActivity" model="registrosRecientes" />

}
else
{
    @* Admin / Investigador dashboard — unchanged *@
    <div class="page-header">
        <div>
            <p class="page-header-subtitle">Resumen general del sistema</p>
        </div>
        <div class="page-header-actions">
            <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-bar-chart-line me-1"></i>Ver reportes
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <partial name="_StatCards" model='@(new BioGamaEcuador.Models.StatCardModel[] { new("Total especies", totalEspecies, "bi-bug", "primary", "col-6 col-xl"), new("Flora", totalFlora, "bi-flower2", "secondary", "col-6 col-xl"), new("Fauna", totalFauna, "bi-binoculars", "info", "col-6 col-xl"), new("Hongos", totalHongos, "bi-moisture", "warning", "col-6 col-xl"), new("Investigadores", totalInvestigadores, "bi-person-badge", "primary", "col-6 col-xl") })' />
    </div>

    <div class="row g-3 mb-4">
        <partial name="_StatCards" model='@(new BioGamaEcuador.Models.StatCardModel[] { new("Reservas naturales", totalReservas, "bi-tree", "secondary", "col-md-4"), new("Registros totales", totalRegistros, "bi-journal-text", "info", "col-md-4") })' />
        <div class="col-md-4">
            <div class="app-card h-100">
                <div class="app-card-header">
                    <h6><i class="bi bi-lightning me-2"></i>Accesos rápidos</h6>
                </div>
                <div class="app-card-body py-2">
                    @if (isAdmin || isInvestigador)
                    {
                        <a asp-controller="Species" asp-action="Create" class="quick-link">
                            <div class="quick-link-icon"><i class="bi bi-plus-lg"></i></div>
                            <div class="quick-link-text"><strong>Nueva especie</strong><span>Registrar en catálogo</span></div>
                        </a>
                    }
                    @if (isAdmin || (isInvestigador && tienePerfilInvestigador))
                    {
                        <a asp-controller="Records" asp-action="Create" class="quick-link">
                            <div class="quick-link-icon"><i class="bi bi-journal-plus"></i></div>
                            <div class="quick-link-text"><strong>Nuevo registro</strong><span>Documentar hallazgo</span></div>
                        </a>
                    }
                    @if (!isAdmin && !isInvestigador)
                    {
                        <a asp-controller="Records" asp-action="Index" class="quick-link">
                            <div class="quick-link-icon"><i class="bi bi-list-ul"></i></div>
                            <div class="quick-link-text"><strong>Ver registros</strong><span>Explorar hallazgos</span></div>
                        </a>
                    }
                </div>
            </div>
    </div>
    </div>

    <partial name="_DashboardCharts" />

    <partial name="_RecentActivity" model="registrosRecientes" />

}

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.js"></script>
    <script>
        Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif";
        Chart.defaults.color = '#6b7280';

        var regionData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            registrosPorRegion.Select(r => new { label = (string)r.Region, value = (int)r.Total })));
        var estadoData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            especiesPorEstado.Select(e => new { label = (string)e.Code, value = (int)e.Total })));

        if (regionData.length) {
            new Chart(document.getElementById('chartRegiones'), {
                type: 'bar',
                data: {
                    labels: regionData.map(d => d.label),
                    datasets: [{
                        label: 'Registros',
                        data: regionData.map(d => d.value),
                        backgroundColor: 'rgba(64, 145, 108, 0.7)',
                        borderColor: '#40916c',
                        borderWidth: 1,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, grid: { color: '#f3f4f6' } },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        if (estadoData.length) {
            new Chart(document.getElementById('chartEstados'), {
                type: 'doughnut',
                data: {
                    labels: estadoData.map(d => d.label),
                    datasets: [{
                        data: estadoData.map(d => d.value),
                        backgroundColor: ['#1b4332','#40916c','#52b788','#74c69d','#95d5b2','#b7e4c7','#d8f3dc','#0369a1'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'right', labels: { boxWidth: 12, padding: 12 } } }
                }
            });
        }
    </script>
}
