@model List<BioGamaEcuador.Models.Species>

@{
    ViewData["Title"] = "Especies";
}

<div class="page-header">
    <div>
        <p class="page-header-subtitle">
            <span class="badge badge-soft-secondary">@ViewBag.TotalItems registros</span>
            @if (ViewBag.ReinoCounts != null)
            {
                foreach (System.Collections.Generic.KeyValuePair<string, int> kv in ViewBag.ReinoCounts)
                {
                    <span class="badge badge-soft-info ms-1">@kv.Key: @kv.Value</span>
                }
            }
        </p>
    </div>
    <div class="page-header-actions">
        @if (User.IsInRole("Administrador") || User.IsInRole("Investigador"))
        {
            <a class="btn btn-primary btn-sm" asp-action="Create">
                <i class="bi bi-plus-lg me-1"></i>Nueva especie
            </a>
        }
    </div>
</div>

<div class="app-card filter-card">
    <div class="app-card-body">
        <form method="get" asp-action="Index">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-2">
                    <label class="form-label" for="filter-busqueda">Buscar</label>
                    <input id="filter-busqueda" type="text" name="busqueda" class="form-control"
                           placeholder="Nombre común o científico…" value="@ViewBag.Busqueda" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label" for="filter-familia">Familia</label>
                    <select id="filter-familia" name="familia" class="form-select">
                        <option value="">Todas</option>
                        @foreach (var f in (List<string>?)ViewBag.Familias ?? new List<string>())
                        {
                            <option value="@f" selected="@(ViewBag.FamiliaFiltro == f)">@f</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label" for="filter-kingdom">Reino</label>
                    <select id="filter-kingdom" name="kingdom" class="form-select">
                        <option value="">Todos</option>
                        @foreach (var k in (List<string>?)ViewBag.Kingdoms ?? new List<string>())
                        {
                            <option value="@k" selected="@(ViewBag.KingdomFiltro == k)">@k</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label" for="filter-estado">Estado</label>
                    <select id="filter-estado" name="estado" class="form-select">
                        <option value="">Todos</option>
                        @foreach (var e in (List<string>?)ViewBag.Estados ?? new List<string>())
                        {
                            <option value="@e" selected="@(ViewBag.EstadoFiltro == e)">@e</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label" for="filter-endemica">Endémica</label>
                    <select id="filter-endemica" name="endemica" class="form-select">
                        <option value="">Todas</option>
                        <option value="true" selected="@(ViewBag.EndémicaFiltro == true)">Sí</option>
                        <option value="false" selected="@(ViewBag.EndémicaFiltro == false)">No</option>
                    </select>
                </div>
                <div class="col-6 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">Filtrar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">Limpiar</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="app-card table-card">
    <div class="table-responsive">
        <table class="table app-table">
            <thead>
                <tr>
                    <th>Nombre común</th>
                    <th>Nombre científico</th>
                    <th>Estado</th>
                    <th>Endémica</th>
                    <th>Familia</th>
                    <th>Creado</th>
                    <th class="actions-cell">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-medium">@item.CommonName</td>
                        <td><em>@item.ScientificName</em></td>
                        <td><span class="badge badge-soft-secondary">@(item.ConservationStatus?.Code ?? "N/D")</span></td>
                        <td>@(item.IsEndemic ? "Sí" : "No")</td>
                        <td>@item.Family?.Name</td>
                        <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="actions-cell">
                            <partial name="_RowActions" model='@(new BioGamaEcuador.Models.RowActionsModel(item.Id, AdminOnlyEdit: false, Tooltips: true, ViewFirst: true))' />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="BioGamaEcuador.Models.PaginationModel.From(ViewContext)" />
