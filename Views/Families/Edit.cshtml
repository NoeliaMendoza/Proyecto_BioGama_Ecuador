@model BioGamaEcuador.Models.Family

@{
    ViewData["Title"] = "Editar familia";
}

<div class="page-header mb-4">
    <h4 class="fw-bold mb-1">Editar familia</h4>
    <p class="text-muted mb-0">Modifique los datos de la clasificacion biologica</p>
</div>

<div class="app-card">
    <div class="app-card-body p-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />

            <partial name="_FormFields" model="Model" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Guardar cambios
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg me-1"></i>Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
