@model List<BioGamaEcuador.Models.Family>

@{
    ViewData["Title"] = "Familias";
}

<div class="page-header d-flex flex-wrap align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1">Familias</h4>
        <p class="text-muted mb-0">Clasificacion biologica de las especies</p>
    </div>
    <div class="page-header-actions">
        @if (User.IsInRole("Administrador") || User.IsInRole("Investigador"))
        {
            <a class="btn btn-primary" asp-action="Create">
                <i class="bi bi-plus-lg me-1"></i>Nueva familia
            </a>
        }
    </div>
</div>

<div class="app-card filter-card mb-4">
    <div class="app-card-body">
        <form method="get" asp-action="Index">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label" for="filter-busqueda">Buscar</label>
                    <input id="filter-busqueda" type="text" name="busqueda" class="form-control" placeholder="Nombre de la familia..." value="@ViewBag.Busqueda" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label" for="filter-reino">Reino</label>
                    <select id="filter-reino" name="reino" class="form-select">
                        <option value="">Todos los reinos</option>
                        @foreach (var k in (List<string>?)ViewBag.Kingdoms ?? new List<string>())
                        {
                            <option value="@k" selected="@(ViewBag.ReinoFiltro == k)">@k</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i>Filtrar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">Limpiar</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="app-card table-card">
    <div class="app-card-header">
        <h5><i class="bi bi-flower2 me-2"></i>Listado de familias</h5>
        <span class="badge badge-soft-primary">Total: @ViewBag.TotalItems</span>
    </div>
    <div class="app-card-body p-0">
        <div class="table-responsive">
            <table class="app-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Reino</th>
                        <th>Estado</th>
                        <th>Creado</th>
                        <th class="actions-cell">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-medium">@item.Name</td>
                            <td>@item.Kingdom</td>
                            <td>
                                <span class="badge @(item.IsActive ? "badge-soft-success" : "badge-soft-secondary")">
                                    @(item.IsActive ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="actions-cell">
                                <partial name="_RowActions" model='@(new BioGamaEcuador.Models.RowActionsModel(item.Id, AdminOnlyEdit: false, Tooltips: true, ViewFirst: true))' />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_Pagination" model="BioGamaEcuador.Models.PaginationModel.From(ViewContext)" />
